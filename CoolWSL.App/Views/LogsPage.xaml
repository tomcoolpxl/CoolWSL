<Page
    x:Class="CoolWSL.App.Views.LogsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CoolWSL.App.Models"
    mc:Ignorable="d"
    UseLayoutRounding="True">
    <ScrollViewer
        x:Name="LogsScroller"
        Background="Transparent"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="LogsContentHost" MaxWidth="{StaticResource WidePageContentMaxWidth}" HorizontalAlignment="Center">
        <StackPanel Width="{Binding ActualWidth, ElementName=LogsContentHost}" Padding="12,32,12,32" Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Logs" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Metadata-only app and WSL command history for the current app session."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        AutomationProperties.Name="Clear logs"
                        Click="OnClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Refresh logs"
                        Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Style="{StaticResource TertiaryTextStyle}"
                Text="{x:Bind ViewModel.LastLoadedText, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="LevelFilterBox"
                            Header="Level"
                            SelectedIndex="0"
                            MinWidth="160"
                            SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Info" />
                        </ComboBox>

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Header="Search"
                            PlaceholderText="Area or message"
                            MinWidth="260"
                            TextChanged="OnSearchTextChanged" />

                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            VerticalAlignment="Bottom" />
                    </Grid>

                    <Border
                        x:Name="EmptyStateCard"
                        x:Load="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="24"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8A5;" />
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="No log entries to show" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Run a WSL action or command, then refresh this page. Logs contain metadata only: command text, status, duration, exit code, area, and timestamp."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater
                        x:Name="LogRepeater"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntryRow">
                                <Border
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource TertiaryTextStyle}" Text="{x:Bind TimestampText}" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Level}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Area}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
