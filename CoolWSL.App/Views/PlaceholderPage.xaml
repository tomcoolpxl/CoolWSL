<Page
    x:Class="CoolWSL.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="32" Spacing="12">
            <TextBlock x:Name="SectionTitleBlock" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SectionDescriptionBlock" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </ScrollViewer>
</Page>