<Page
    x:Class="CoolWSL.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="using:CoolWSL.Diagnostics.Models"
    xmlns:models="using:CoolWSL.App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="32" Spacing="24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diagnostics" />
                    <TextBlock
                        Opacity="0.72"
                        Text="Review WSL health, raw command evidence, and per-distro DNS and internet checks without making any changes automatically."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Refresh" Click="OnRefreshClick" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.RefreshStatusText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind ViewModel.WarningText, Mode=OneWay}" TextWrapping="WrapWholeWords" />

            <Border Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Per-distro context" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.Distros, Mode=OneWay}"
                        PlaceholderText="Choose a distro for DNS and internet checks"
                        SelectionChanged="OnDistroSelectionChanged"
                        SelectedItem="{x:Bind ViewModel.SelectedDistro, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="diagnostics:DiagnosticResult">
                        <Border Margin="0,0,0,12" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SeverityLabel}" />
                                    <Button Grid.Column="2" Click="OnRetryClick" Content="Retry" />
                                </Grid>
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="DiagnosticDetailsBlock" x:Load="{x:Bind HasDetails}" Opacity="0.72" Text="{x:Bind Details}" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="DiagnosticSuggestedNextStepBlock" x:Load="{x:Bind HasSuggestedNextStep}" Opacity="0.72" Text="{x:Bind SuggestedNextStep}" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="DiagnosticCommandTextBlock" x:Load="{x:Bind HasCommandText}" Opacity="0.72" Text="{x:Bind CommandText}" TextWrapping="WrapWholeWords" />
                                <TextBox
                                    x:Name="DiagnosticRawOutputBox"
                                    x:Load="{x:Bind HasRawOutput}"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    IsReadOnly="True"
                                    MinHeight="120"
                                    Text="{x:Bind RawOutput}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>