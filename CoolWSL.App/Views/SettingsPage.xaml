<Page
    x:Class="CoolWSL.App.Views.SettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True">
    <ScrollViewer
        x:Name="SettingsScroller"
        Background="Transparent"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsContentHost" MaxWidth="{StaticResource WidePageContentMaxWidth}" HorizontalAlignment="Center">
        <StackPanel Width="{Binding ActualWidth, ElementName=SettingsContentHost}" Padding="12,32,12,32" Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Settings" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="WSL defaults, app preferences, and product information."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Refresh settings status"
                        Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Style="{StaticResource TertiaryTextStyle}"
                Text="{x:Bind ViewModel.LastLoadedText, Mode=OneWay}" />

            <TextBlock
                x:Name="ActionStatusBlock"
                x:Load="{x:Bind ViewModel.HasActionStatus, Mode=OneWay}"
                Text="{x:Bind ViewModel.ActionStatusText, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEC7A;" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="WSL" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Global WSL state and safe global actions." />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Status" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WslStatusText, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                            <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Default distro" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DefaultDistroText, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                            <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="Inventory" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DistroSummaryText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.Name="Open default WSL terminal"
                                Click="OnOpenDefaultClick"
                                IsEnabled="{x:Bind ViewModel.CanOpenDefaultDistro, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE756;" />
                                    <TextBlock Text="Open default WSL terminal" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Shutdown all WSL distros"
                                Click="OnShutdownAllClick"
                                IsEnabled="{x:Bind ViewModel.CanRunActions, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE7E8;" />
                                    <TextBlock Text="Shutdown all WSL" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Global .wslconfig" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Style="{StaticResource TertiaryTextStyle}"
                                            Text="{x:Bind ViewModel.GlobalConfigPathText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind ViewModel.GlobalConfigStateText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                        <Button
                                            AutomationProperties.Name="WSL Settings"
                                            Click="OnOpenWslSettingsClick"
                                            Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE713;" />
                                                <TextBlock Text="WSL Settings" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.GlobalConfigRecommendedText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBox
                                    x:Name="GlobalConfigViewerBox"
                                    x:Load="{x:Bind ViewModel.HasGlobalConfigFile, Mode=OneWay}"
                                    AcceptsReturn="True"
                                    AutomationProperties.Name="Read-only global WSL config viewer"
                                    FontFamily="Consolas"
                                    IsReadOnly="True"
                                    MinHeight="260"
                                    Text="{x:Bind ViewModel.GlobalConfigContent, Mode=OneWay}"
                                    TextWrapping="NoWrap" />

                                <TextBlock
                                    x:Name="GlobalConfigValidationBlock"
                                    x:Load="{x:Bind ViewModel.HasGlobalConfigValidationIssues, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="{x:Bind ViewModel.GlobalConfigValidationText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Global `.wslconfig` changes affect WSL 2 only and take effect after WSL restarts. Microsoft recommends making those changes in WSL Settings rather than editing the file manually."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Appearance" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Theme and window rendering preferences." />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Theme" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                Width="{StaticResource SettingsValueControlWidth}"
                                HorizontalAlignment="Right"
                                SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                        <ToggleSwitch
                            Header="Use Mica backdrop"
                            IsEnabled="False"
                            IsOn="False"
                            OffContent="Disabled for text clarity"
                            OnContent="Enabled" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Theme changes apply immediately and persist across launches. Mica remains disabled because the text-rendering pass removed it to keep ClearType crisp."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B0;" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Behaviour" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Safety defaults and command behavior." />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <ToggleSwitch
                            Header="Confirm destructive WSL actions"
                            IsEnabled="False"
                            IsOn="True"
                            HorizontalAlignment="Right"
                            MinWidth="{StaticResource SettingsValueControlWidth}"
                            OffContent="Off"
                            OnContent="On" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Default command timeout" VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Width="{StaticResource SettingsValueControlWidth}"
                                Text="15 seconds"
                                IsEnabled="False"
                                HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="These controls are visible now so Settings has the final shape, but persistence lands with Phase 18 user preferences."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="About" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Version and project links." />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <Border
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="72"
                                    Height="72"
                                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                    CornerRadius="20"
                                    Padding="10"
                                    VerticalAlignment="Top">
                                    <Image
                                        Source="ms-appx:///Assets/Square150x150Logo.png"
                                        Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="CoolWSL" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="WSL control center for Windows 11."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Product" />
                            <TextBlock Grid.Column="1" Text="CoolWSL" />

                            <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Version" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind AppVersion}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.Name="Open repository" Click="OnOpenRepositoryClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE774;" />
                                    <TextBlock Text="Open repository" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Report issue" Click="OnReportIssueClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE7BA;" />
                                    <TextBlock Text="Report issue" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
