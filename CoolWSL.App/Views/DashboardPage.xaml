<Page
    x:Class="CoolWSL.App.Views.DashboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="32" Spacing="24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Dashboard" />
                    <TextBlock
                        Opacity="0.72"
                        Text="Read-only WSL environment status and distro inventory."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                    <Button
                        Content="Refresh"
                        Click="OnRefreshClick"
                        IsEnabled="{x:Bind ViewModel.State.CanRefresh, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.State.IsLoading, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.State.RefreshStatus, Mode=OneWay}" />

            <Border Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="WSL status" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.State.AvailabilityLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.State.Summary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.State.WarningText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.State.SuggestedNextStep, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontWeight="SemiBold" Text="WSL version" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.State.WslVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Kernel version" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.State.KernelVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Default WSL version" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.State.DefaultWslVersion, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Distro inventory" />
                    <TextBlock Text="{x:Bind ViewModel.State.DistroSectionSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.State.EmptyStateTitle, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.State.EmptyStateMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontWeight="SemiBold" Text="Name" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="State" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Version" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Default" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.State.Distros, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" />
                                    <TextBlock Grid.Column="2" Text="{Binding WslVersion}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DefaultLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>