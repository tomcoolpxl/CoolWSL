<Page
    x:Class="CoolWSL.App.Views.DashboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:CoolWSL.App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True">
    <ScrollViewer
        x:Name="DashboardScroller"
        Background="Transparent"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch">
        <Grid x:Name="DashboardContentHost" MaxWidth="{StaticResource WidePageContentMaxWidth}" HorizontalAlignment="Center">
        <StackPanel Width="{Binding ActualWidth, ElementName=DashboardContentHost}" Padding="12,32,12,32" Spacing="20">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Dashboard" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="WSL environment status, distro inventory, and quick actions."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.State.IsLoading, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Refresh dashboard"
                        Click="OnRefreshClick"
                        IsEnabled="{x:Bind ViewModel.State.CanRefresh, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Style="{StaticResource TertiaryTextStyle}"
                Text="{x:Bind ViewModel.State.RefreshStatus, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.State.AvailabilityLabel, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.State.Summary, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <TextBlock
                        x:Name="WarningBlock"
                        x:Load="{x:Bind ViewModel.State.HasWarning, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind ViewModel.State.WarningText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        x:Name="NextStepBlock"
                        x:Load="{x:Bind ViewModel.State.HasSuggestedNextStep, Mode=OneWay}"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.State.SuggestedNextStep, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="WSL version" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.State.WslVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Kernel version" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.State.KernelVersion, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="Default WSL version" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.State.DefaultWslVersion, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                Text="{x:Bind ViewModel.ActionStatusText, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="Open default WSL terminal"
                    Click="OnOpenDefaultClick"
                    IsEnabled="{x:Bind ViewModel.State.CanOpenDefaultDistro, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xEC7A;" />
                        <TextBlock Text="Open default WSL terminal" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Shutdown all WSL distros"
                    Click="OnShutdownAllClick"
                    IsEnabled="{x:Bind ViewModel.State.CanShutdownAll, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE7E8;" />
                        <TextBlock Text="Shutdown all WSL" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Distros" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.State.DistroSectionSummary, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border
                x:Name="EmptyStateCard"
                x:Load="{x:Bind ViewModel.State.ShowEmptyState, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.State.EmptyStateTitle, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.State.EmptyStateMessage, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <ItemsRepeater
                x:Name="DistroRepeater"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.State.Distros, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardDistroRow">
                        <Button
                            AutomationProperties.Name="{x:Bind OpenAutomationName}"
                            Click="OnDistroTileClick"
                            Tag="{x:Bind Name}"
                            Style="{StaticResource TileButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xEC7A;"
                                    VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            x:Name="DefaultBadge"
                                            x:Load="{x:Bind IsDefault}"
                                            Style="{StaticResource TertiaryTextStyle}"
                                            Text="Default"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="ManagementBadge"
                                            x:Load="{x:Bind HasManagementLabel}"
                                            Style="{StaticResource TertiaryTextStyle}"
                                            Text="{x:Bind ManagementLabel}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind CapabilityMessage}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,2,10,2"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind State}" />
                                </Border>

                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource TertiaryTextStyle}"
                                    Text="{x:Bind WslVersion}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
