<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="CoolWSL"
    Manufacturer="CoolWSL"
    Version="$(CoolWslInstallerVersion)"
    UpgradeCode="6D2A8580-57C6-4267-A6F7-5F29B671E6C3"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="CoolWSLProductIcon.ico" SourceFile="$(CoolWslInstallerIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CoolWSLProductIcon.ico" />

    <ui:WixUI Id="WixUI_Minimal" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch CoolWSL" />
    <CustomAction Id="LaunchApplication"
            BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
            DllEntry="WixShellExec"
            Execute="immediate"
            Return="ignore"
            Impersonate="yes" />
    <SetProperty Id="WixShellExecTarget"
                 Value="[INSTALLFOLDER]CoolWSL.App.exe"
                 Before="LaunchApplication"
                 Sequence="ui" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <InstallUISequence>
      <Custom Action="LaunchApplication" Before="AppSearch" Condition="0" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CoolWSL" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CoolWSLProgramMenuFolder" Name="CoolWSL" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="CoolWSL" Level="1">
      <ComponentGroupRef Id="InstallFiles" />
    </Feature>
  </Package>
</Wix>